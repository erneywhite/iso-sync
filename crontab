# =============================================================================
# Примеры cron-задач для iso-sync
# =============================================================================
# Замените /path/to/ на абсолютный путь к репозиторию.
# Оба скрипта защищены flock — пересечение запусков безопасно.
# При запуске не из TTY прогресс-бар автоматически переключается в компактный
# режим (без \r), поэтому логи в cron-выводе не разрастаются.
# =============================================================================

# -----------------------------------------------------------------------------
# Вариант A (рекомендуется) — раздельное расписание
# -----------------------------------------------------------------------------
# Хэши пересчитываются каждый час: ловим ручные изменения файлов в files/
# (например, если положили ISO туда руками без update_iso.php).
# Обновление образов — раз в сутки в полночь.
# -----------------------------------------------------------------------------

0 * * * *  php /path/to/generate_all_hashes.php > /dev/null 2>&1
0 0 * * *  php /path/to/update_iso.php          > /dev/null 2>&1

# -----------------------------------------------------------------------------
# Вариант B — только обновление (без отдельного крона на хэши)
# -----------------------------------------------------------------------------
# update_iso.php в конце сам запускает generate_all_hashes.php, так что для
# минимальной конфигурации достаточно одной строки. Минус: если файлы
# меняются между запусками update_iso (например, ручное копирование),
# хэши обновятся только при следующем прогоне.
# -----------------------------------------------------------------------------

# 0 0 * * 6  php /path/to/update_iso.php > /dev/null 2>&1   # раз в неделю, ночь субботы

# -----------------------------------------------------------------------------
# Сборка образов Windows через UUP dump (build_uup.php)
# -----------------------------------------------------------------------------
# Отдельная задача: прогон идёт часами и упирается в диск и процессор, тогда
# как update_iso — быстрая проверка. Свой flock не даёт сборкам пересечься
# ни между собой, ни с повторным запуском по крону.
#
# Расписание еженедельное, хотя апстрим обновляется раз в месяц: если сборка
# не изменилась, скрипт выходит сразу после запроса каталога, не качая ничего.
# Так свежий билд подхватывается в пределах недели после выхода, а не ждёт
# фиксированной даты. Microsoft обновляет образы вскоре после Patch Tuesday
# (второй вторник месяца), поэтому целимся в ночь на воскресенье.
#
# ВАЖНО: путь к PHP указывать полный. Системный php в PATH может оказаться
# другой сборкой без нужных расширений (на проде так и есть: /usr/bin/php8.3
# без curl и mbstring, тогда как сайт работает под php85).
#
# ВАЖНО: разносить по времени с update_iso.php. Локи у них разные, поэтому
# одновременный запуск не блокируется, а вот пересчёт хэшей общий и защищён
# СВОИМ локом: кто добежал вторым, тихо выйдет, и свежий образ останется в UI
# без SHA256 до следующего прогона. Плюс они просто конкурируют за канал и диск.
# Практика: update_iso в 01:30, сборка в 04:00 — запас в 2.5 часа.
#
# 30 2 * * 0  /www/server/php/85/bin/php /path/to/build_uup.php > /dev/null 2>&1

# Чтобы видеть, чем закончился прогон, лог удобнее не выбрасывать:
# 30 2 * * 0  /www/server/php/85/bin/php /path/to/build_uup.php >> /path/to/logs/uup-cron.log 2>&1
#
# Внимание при запуске из панели (aaPanel): она показывает в логе задачи то,
# что команда вывела в stdout/stderr. Строка выше уводит ОБА потока в файл, и
# в панели остаётся только её собственная пометка «Successful». Если нужен и
# файл, и вывод в панели — писать в файл, а в панель отдавать хвост:
#
#   LOG=/path/to/logs/uup-cron.log
#   /www/server/php/85/bin/php /path/to/build_uup.php >> "$LOG" 2>&1
#   code=$?
#   tail -n 40 "$LOG"
#   exit $code
#
# Через `... | tee -a "$LOG"` делать НЕ стоит: при пайпе код возврата берётся
# от tee, и панель нарисует «Successful» даже когда сборка упала.

# Запуск от того же пользователя, что и остальные задачи (на проде — www),
# иначе собранный ISO ляжет с чужим владельцем:
# 30 2 * * 0  su -s /bin/bash www -c '/www/server/php/85/bin/php /path/to/build_uup.php' > /dev/null 2>&1
